# ── Claude AI (Studio: generazione e personalizzazione template) ──────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── URL del sito ──────────────────────────────────────────────────────────────
# Usato per i redirect di Stripe e per i link nelle email. Deve essere l'URL
# canonico: NON viene mai dedotto dagli header della richiesta (open redirect).
NEXT_PUBLIC_SITE_URL=https://tuodominio.com
NEXT_PUBLIC_APP_URL=https://tuodominio.com

# ── Clerk (autenticazione) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Stripe (pagamenti) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Opzionale: il prezzo mensile Studio Access ha un default nel codice
# (app/api/checkout/route.ts). Impostala solo per puntare a un altro account
# Stripe o a un prezzo diverso.
STUDIO_ACCESS_PRICE_ID=price_...           # abbonamento Studio Access
STUDIO_ACCESS_LIFETIME_PRICE_ID=price_...  # Studio Access a vita

# ── Supabase (acquisti, recensioni, wishlist, uso AI) ─────────────────────────
# La service role key bypassa le RLS: solo server-side, mai esposta al client.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USER_ID=user_...  # Clerk user id abilitato a /admin/newsletter

# ── Upstash Redis (rate limiting distribuito) ─────────────────────────────────
# Senza queste il limiter ricade su quello in-memory, che non è condiviso fra
# le istanze serverless.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Resend (email post-acquisto e newsletter) — opzionale ─────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=Forma <noreply@templatelab.io>

# ── PostHog (analytics) — opzionale ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry (error tracking) — opzionale ───────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
