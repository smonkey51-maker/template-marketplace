# ── URL del sito ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tuodominio.com

# ── Resend (notifica nuovo iscritto newsletter) — opzionale ───────────────────
# Senza questa variabile /api/subscribe accetta comunque le iscrizioni, ma
# nessuna email di notifica viene inviata (no-op silenzioso).
RESEND_API_KEY=re_...
RESEND_FROM=ACUME <noreply@tuodominio.com>
# Indirizzo che riceve la notifica di ogni nuova iscrizione. In assenza,
# ricade su RESEND_FROM.
RESEND_NOTIFY_TO=tuo@indirizzo.com

# ── PostHog (analytics) — opzionale ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
